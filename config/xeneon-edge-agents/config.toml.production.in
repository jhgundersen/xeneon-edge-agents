# Agent manager observed at startup: "herdr" or "t3code". The portal's
# Manager control switches between them at runtime and persists the choice
# under $XDG_STATE_HOME/xeneon-edge-agents/agent-backend.toml.
agent_backend = "herdr"
herdr_bin = "herdr"
voxtype_bin = "voxtype"
herdr_refresh_ms = 5000
health_refresh_ms = 1000
voice_refresh_ms = 250
usage_refresh_ms = 30000
micro_refresh_ms = 5000

[screen]
connector = "@OUTPUT_CONNECTOR@"
serial = "@OUTPUT_SERIAL@"
model = "@OUTPUT_MODEL@"
touch_device = "@TOUCH_DEVICE@"

[t3code]
# T3 Code data directory. Defaults to $T3CODE_HOME, then ~/.t3. Only the
# read-only state projection and server runtime descriptor are read.
# home = "/home/user/.t3"
refresh_ms = 1000

[desktop]
edge_output = "@OUTPUT_CONNECTOR@"
herdr_class = "herdr"

# Header shortcuts: 0-4 apps, shown left to right. Leave every
# [[desktop.apps]] entry out to keep the built-in Spotify and Discord pair,
# or write `apps = []` under [desktop] for none. The portal can only name an
# id from this list; launching and focusing are resolved here.
#
#   id          lowercase letters, digits, or "-" (sent back by the portal)
#   label       button text, at most 16 characters
#   desktop_id  bare desktop entry name, launched with `uwsm app`
#   class       exact Hyprland window class (`hyprctl clients`)
#   title       optional initial title preferred when several windows match
#   accent      accent, green, blue, cyan, magenta, orange, or yellow
#
# [[desktop.apps]]
# id = "spotify"
# label = "Spotify"
# desktop_id = "spotify.desktop"
# class = "spotify"
# accent = "green"
#
# [[desktop.apps]]
# id = "slack"
# label = "Slack"
# desktop_id = "slack.desktop"
# class = "Slack"
# accent = "magenta"
